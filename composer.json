{
  "name": "jschaedl/api-client",
  "license": "MIT",
  "type": "library",
  "description": "A generic api client implementation to avoid writing the same boiler plate code over and over again.",
  "keywords": [
    "PHP",
    "generic",
    "api",
    "client"
  ],
  "homepage": "https://github.com/jschaedl/api-client",
  "authors": [
    {
      "name": "Jan Schädlich",
      "homepage": "https://janschaedlich.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Api\\": "src/Api"
    },
    "files": [
      "examples/_function.php"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
    "psr/clock": "^1.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1||^2.0",
    "webmozart/assert": "^1.11"
  },
  "require-dev": {
    "brianium/paratest": "^7.8",
    "friendsofphp/php-cs-fixer": "^3.75",
    "guzzlehttp/guzzle": "^7.9",
    "guzzlehttp/psr7": "^2.7",
    "nyholm/psr7": "^1.8",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.0",
    "symfony/http-client": "^6.4||^7.0",
    "tomasvotruba/cognitive-complexity": "^1.0",
    "tomasvotruba/type-coverage": "^2.0"
  },
  "provide": {
    "php-http/client-implementation": "*"
  },
  "suggest": {
    "symfony/http-client": "PSR-18 client (Psr18Client) that also implements the PSR-17 factories"
  }
}
