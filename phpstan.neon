includes:
  - .phpstan/config.neon
  - .phpstan/baseline.neon


parameters:
  paths:
      - src

  cognitive_complexity:
      class: 50
      function: 12

  type_coverage:
      return_type: 99
      param_type: 99
      property_type: 99
      # typed class constants need PHP 8.3; raise once PHP 8.2 support is dropped
      constant_type: 0
